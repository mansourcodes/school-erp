{
  "name": "ghadeer-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm run lint:fsd && npm run test && vite build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
